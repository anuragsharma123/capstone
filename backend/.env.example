# --- Server ---
PORT=8001

# --- Storage ---
# Real Postgres via `embedded-postgres` — a genuine prebuilt Postgres
# binary downloaded through npm (no Docker, no system/Homebrew install).
# Data persists between restarts in PG_DATA_DIR. PG_PORT is a local,
# unusual default so it doesn't collide with a system Postgres that might
# already be on 5432.
PG_PORT=54329
PG_DATA_DIR=./pgdata
PG_PASSWORD=anurag_dev_password

# --- Credential encryption (Rule 3 — envelope encryption) ---
# The "KMS master key" that wraps each connection's per-secret data key.
# Must be a base64-encoded 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit the real value; this file only documents the shape.
KMS_MASTER_KEY=

# --- Agent Builder (parse_intent) ---
# Used only to turn a user's free-text prompt into a structured intent
# (name/description/system_prompt/keywords) — never to decide tool access,
# sensitivity, or approval requirements; those are code-decided (Rule 4).
ANTHROPIC_API_KEY=
